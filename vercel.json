{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "entrypoint": "vercel-entry.mjs",
      "installCommand": "pnpm install --frozen-lockfile --prod=false",
      "buildCommand": "pnpm --filter @fileforge/database generate && pnpm run build",
      "devCommand": "pnpm run dev",
      "outputDirectory": "dist",
      "functions": {
        "dist/main.mjs": {
          "includeFiles": "dist/**"
        }
      }
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "pnpm install --frozen-lockfile --prod=false",
      "buildCommand": "pnpm --filter @fileforge/database generate && pnpm run build",
      "devCommand": "pnpm run dev",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "FILEFORGE_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
