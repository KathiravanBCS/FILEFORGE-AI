generator client {
  provider = "prisma-client"
  output = "../src/generated"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  members Member[]
  invitations Invitation[]
  preferences UserPreferences?
  uploadedFiles File[]
  jobs ProcessingJob[]
  scans BusinessCardScan[]
  contacts Contact[]
  exports ExportRecord[]
  usage UsageRecord[]
  auditLogs AuditLog[]
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  activeOrganizationId String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}

model Organization {
  id String @id
  name String
  slug String @unique
  logo String?
  metadata String?
  createdAt DateTime @default(now())
  members Member[]
  invitations Invitation[]
  files File[]
  jobs ProcessingJob[]
  scans BusinessCardScan[]
  contacts Contact[]
  exports ExportRecord[]
  usage UsageRecord[]
  auditLogs AuditLog[]
}

model Member {
  id String @id
  organizationId String
  userId String
  role String @default("member")
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id String @id
  organizationId String
  email String
  role String?
  status String @default("pending")
  expiresAt DateTime
  inviterId String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  @@index([organizationId, email])
}

model UserPreferences {
  id String @id @default(uuid())
  userId String @unique
  colorScheme String @default("auto")
  primaryColor String @default("blue")
  density String @default("comfortable")
  radius String @default("md")
  reducedMotion Boolean @default(false)
  language String @default("en")
  timeZone String @default("UTC")
  tablePreferences Json @default("{}")
  dashboardPreferences Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id String @id @default(uuid())
  organizationId String
  uploadedById String
  originalName String
  objectKey String @unique
  mimeType String
  size Int
  status String @default("uploaded")
  createdAt DateTime @default(now())
  deletedAt DateTime?
  expiresAt DateTime?
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scanImages ScanImage[]
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

model ProcessingJob {
  id String @id @default(uuid())
  organizationId String
  createdById String
  type String
  status String @default("queued")
  progress Int @default(0)
  attempts Int @default(0)
  error String?
  queueJobId String? @unique
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan BusinessCardScan?
  export ExportRecord?
  @@index([organizationId, status, createdAt])
}

model BusinessCardScan {
  id String @id @default(uuid())
  organizationId String
  createdById String
  jobId String @unique
  extractedData Json?
  model String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  images ScanImage[]
  contacts Contact[]
  @@index([organizationId, createdAt])
}

model ScanImage {
  scanId String
  fileId String
  position Int
  scan BusinessCardScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@id([scanId, fileId])
  @@unique([scanId, position])
}

model Contact {
  id String @id @default(uuid())
  organizationId String
  createdById String
  scanId String?
  fullName String?
  firstName String?
  lastName String?
  jobTitle String?
  company String?
  department String?
  address String?
  city String?
  state String?
  country String?
  postalCode String?
  notes String?
  websites String[] @default([])
  status String @default("draft")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scan BusinessCardScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  emails ContactEmail[]
  phones ContactPhone[]
  socialLinks ContactSocial[]
  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, fullName])
  @@index([organizationId, company])
}

model ContactEmail {
  id String @id @default(uuid())
  contactId String
  email String
  label String?
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
}

model ContactPhone {
  id String @id @default(uuid())
  contactId String
  number String
  label String?
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
}

model ContactSocial {
  id String @id @default(uuid())
  contactId String
  url String
  label String?
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@index([contactId])
}

model ExportRecord {
  id String @id @default(uuid())
  organizationId String
  createdById String
  jobId String @unique
  objectKey String? @unique
  fileName String?
  filters Json
  count Int @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime?
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job ProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

model UsageRecord {
  id String @id @default(uuid())
  organizationId String
  userId String
  jobId String?
  type String
  quantity Int @default(1)
  inputTokens Int @default(0)
  outputTokens Int @default(0)
  estimatedCost Decimal? @db.Decimal(12, 6)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
  @@unique([jobId, type])
}

model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorId String
  action String
  resourceType String
  resourceId String?
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
