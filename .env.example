# Copy to .env at the repository root. Supply secrets securely; never commit .env.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000

# Neon pooled application connection and direct migration connection (TLS required)
DATABASE_URL=
DIRECT_URL=

# Use a cryptographically random value of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Cloudflare R2 private bucket, not a public bucket URL
STORAGE_PROVIDER=r2
S3_BUCKET=file-processing
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upstash TLS protocol, e.g. rediss://default:password@host.upstash.io:6379
REDIS_URL=
WORKER_CONCURRENCY=2

# No fallback model is silently selected. Verify this model is available to your account.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Optional: verification, reset, and invitation email remain unavailable until configured
RESEND_API_KEY=
EMAIL_FROM=

# Optional OAuth providers (configure redirect URLs in the provider consoles)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Retention and optional cost accounting
FILE_RETENTION_DAYS=30
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
