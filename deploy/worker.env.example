# Configure these on the background-worker host. Never commit filled credentials.
NODE_ENV=production

# Use the SAME database, Redis and private R2 bucket as the Vercel API.
DATABASE_URL=
REDIS_URL=
STORAGE_PROVIDER=r2
S3_BUCKET=file-processing
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# A Groq key and an available image-capable model are required for scans.
GROQ_API_KEY=
GROQ_VISION_MODEL=
WORKER_CONCURRENCY=1
FILE_RETENTION_DAYS=30
